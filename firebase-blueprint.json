        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "ownerId", "matterName", "matterNumber", "client", "status"]
    },
    "DocumentItem": {
      "title": "DocumentItem",
      "description": "Legal document uploaded to a matter",
      "type": "object",
