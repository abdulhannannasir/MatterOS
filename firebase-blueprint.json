  "firestore": {
    "/organizations/{organizationId}": {
      "schema": "Organization",
      "description": "Stores law firm organizations and multi-tenant settings"
    },
    "/organizationMembers/{memberId}": {
      "schema": "OrganizationMember",
      "description": "Stores law firm memberships, user roles, and access assignments"
    },
    "/organizationInvitations/{invitationId}": {
      "schema": "OrganizationInvitation",
      "description": "Stores firm member invitations"
    },
    "/auditLogs/{logId}": {
      "schema": "AuditLogEntry",
      "description": "Stores immutable law firm audit events and compliance logs"
    },
    "/notifications/{notificationId}": {
      "schema": "NotificationItem",
      "description": "Stores user notifications for matter deadlines and assignments"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Stores user profiles with owner-restricted access"
    },
    "/matters/{matterId}": {
      "schema": "Matter",
      "description": "Stores legal matters belonging to a user/firm"
    },
    "/documents/{documentId}": {
      "schema": "DocumentItem",
      "description": "Stores legal documents linked to matters"
    },
    "/documentAnalyses/{analysisId}": {
      "schema": "DocumentAnalysis",
      "description": "Stores structured intelligence outputs from Gemini"
    },
    "/timelineEvents/{eventId}": {
      "schema": "TimelineEvent",
      "description": "Stores chronological timeline milestones"
    },
    "/issues/{issueId}": {
      "schema": "Issue",
      "description": "Stores legal/factual issues for matters"
    },
    "/evidence/{evidenceId}": {
      "schema": "Evidence",
      "description": "Stores indexed evidence records"
    },
    "/deadlines/{deadlineId}": {
      "schema": "Deadline",
      "description": "Stores calendar deadlines and statutory cutoffs"
    },
    "/activities/{activityId}": {
      "schema": "Activity",
      "description": "Stores audit log activities"
    },
    "/aiConversations/{conversationId}": {
      "schema": "AiConversation",
      "description": "Stores AI workspace conversation history"
    },
    "/matterRelationships/{relationshipId}": {
      "schema": "MatterRelationship",
      "description": "Stores cross-document relationships"
    },
    "/matterFacts/{factId}": {
      "schema": "MatterFact",
      "description": "Stores structured facts with source tracking"
    },
    "/matterContradictions/{contradictionId}": {
      "schema": "MatterContradiction",
      "description": "Stores potential cross-document contradictions"
    },
    "/matterMissingInformation/{missingInfoId}": {
      "schema": "MatterMissingInformation",
      "description": "Stores detected missing references"
    },
    "/tasks/{taskId}": {
      "schema": "Task",
      "description": "Stores matter tasks with assignment, status, and lawyer approval"
    },
    "/notes/{noteId}": {
      "schema": "MatterNote",
      "description": "Stores attorney matter notes kept separate from AI facts"
    }
  }
}
