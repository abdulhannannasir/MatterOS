        "extractedText": { "type": "string" },
        "fileData": { "type": "string" }
      },
      "required": ["id", "matterId", "ownerId", "filename", "category"]
    },
    "DocumentAnalysis": {
      "title": "DocumentAnalysis",
      "description": "Structured AI intelligence extracted from a document",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "documentId": { "type": "string" },
        "matterId": { "type": "string" },
        "ownerId": { "type": "string" },
        "documentSummary": { "type": "string" },
        "documentType": { "type": "string" },
        "modelUsed": { "type": "string" },
        "analyzedAt": { "type": "string" }
      },
      "required": ["id", "documentId", "matterId", "ownerId"]
    },
    "TimelineEvent": {
      "title": "TimelineEvent",
      "description": "Chronological factual event in the matter",
