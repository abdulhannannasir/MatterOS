{
  "entities": {
    "Organization": {
      "title": "Organization",
      "description": "Law firm or legal organization workspace",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "ownerId": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "ownerId"]
    },
    "OrganizationMember": {
      "title": "OrganizationMember",
      "description": "User membership and assigned role within an organization",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "organizationId": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "userName": { "type": "string" },
        "role": { "type": "string" },
        "status": { "type": "string" },
        "joinedAt": { "type": "string" }
      },
      "required": ["id", "organizationId", "userId", "role"]
    },
    "OrganizationInvitation": {
      "title": "OrganizationInvitation",
      "description": "Pending invitation to join a law firm organization",
      "type": "object",
