        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "matterId", "ownerId", "title", "status"]
    },
    "Evidence": {
      "title": "Evidence",
      "description": "Evidence item indexed for a matter",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "matterId": { "type": "string" },
        "ownerId": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "description": { "type": "string" },
        "sourceDocument": { "type": "string" },
        "date": { "type": "string" },
        "status": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "matterId", "ownerId", "name", "type"]
    },
    "Deadline": {
      "title": "Deadline",
      "description": "Filing or statutory deadline in the matter",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "matterId": { "type": "string" },
        "ownerId": { "type": "string" },
        "title": { "type": "string" },
        "date": { "type": "string" },
        "description": { "type": "string" },
        "source": { "type": "string" },
        "status": { "type": "string" },
        "priority": { "type": "string" },
        "isAiSuggested": { "type": "boolean" },
        "isLawyerConfirmed": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "matterId", "ownerId", "title", "date", "status"]
    },
    "Activity": {
      "title": "Activity",
      "description": "Audit and operational activity trail",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "matterId": { "type": "string" },
        "ownerId": { "type": "string" },
        "userEmail": { "type": "string" },
        "action": { "type": "string" },
        "details": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "ownerId", "action", "timestamp"]
    },
    "AiConversation": {
      "title": "AiConversation",
      "description": "AI Workspace chat session for a matter",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "matterId": { "type": "string" },
